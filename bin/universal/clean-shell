#!/bin/bash

set -euo pipefail

usage () { cat <<EOS; }
usage: $(basename -- "$0") SHELL [_clenv option] [shell options]

Starts a "clean shell" up, without any noise from the environment/startup files

Options passed to clenv must start with a '_' and be one word (eg '_p' or
'_m^SampShell_'). Other options are passed to the shell.

You can also specify '-s' to pass all sampshell variables through, or '-v' to
enable logging.s
EOS

# Fetch the shell name (making sure it's supplied)
if (( $# == 0 )); then usage >&2; exit 1; fi
shellname=$1
shift

# Setup variable lists
clenv_args=()
shell_args=()

# Default shell variables for each shell to limit startup files
case $shellname in
zsh|*/zsh)
	shell_args+=( --no-globalrcs --no-rcs ) ;;
bash|*/bash)
	# Ignore macOS's deprecation of bash
	[[ "$(uname)" = Darwin ]] && clenv_args+=( -vBASH_SILENCE_DEPRECATION_WARNING=1 )

	shell_args+=( --noprofile --norc ) ;;
esac

verbose=

# Parse clenv arguments, if present
while (( $# > 0 )); do
	arg=$1
	shift

	case $arg in
	--) shell_args+=( "$@" ); break ;;
	-h) usage; exit ;;
	-s) clenv_args+=( -m'^SampShell_' ) ;;
	-v) verbose=1;;
	-sv|-vs) clenv_args+=( -m'^SampShell_' ); verbose=1 ;;
	_*) clenv_args+=( -"${arg#_}" ) ;;
	*)  shell_args+=( "$arg" ) ;;
	esac
done

[[ $verbose ]] && set -x
exec clenv "${clenv_args[@]+"${clenv_args[@]}"}" -- "$shellname" "${shell_args[@]+"${shell_args[@]}"}"
