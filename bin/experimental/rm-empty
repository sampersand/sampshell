#!/usr/bin/env ruby

require 'optparse2'
require 'gvars'

def warn(msg) = super("#{File.basename($0)}: #{msg}")

OptParse2.new do |op|
  op.summary <<~EOS
    Delete empty files/directories. Note that this does have a race condition
    with deleting empty files, as there's no way to actually guarantee they're
    empty.
  EOS

  op.group :kind do
    $kind = :both # default
    op.on '-f', '--files',       'Only delete empty files (last of -f/-d/--both wins)'
    op.on '-d', '--directories', 'Only delete empty directories (last of -f/-d/--both wins)'
    op.on       '--both',        'Delete empty files and directories [default]'
  end

  op.on '-n', '--dry-run',   "Don't actually do removals (implies -v)" do $verbose = true end
  op.on '-r', '--recursive', 'Recursively descend into folders'

  op.on '-v', '--verbose', 'Emit verbose output'
  op.on       '--[no-]ds-store', 'Delete .DS_Store entries in folders on macos', default: true

  op.rest 'paths', 'The paths to delete', required: 1

  op.parse! into: GVars, abort: true
end

DELETE_DS_STORE = RUBY_PLATFORM.include?('darwin') && $ds_store

if $verbose
  def log(...) = puts(...)
else
  def log(...) end
end

def delete_path(path, is_first:)
  unless File.exist?(path)
    warn "path does not exist: #{path}"
    $SUCCESS = false
    return
  end

  case (ftype = File.ftype(path))
  when 'file'
    if $kind == :directories
      log "not removing non-directory path: #{path}"
    elsif !File.empty?(path)
      log "not removing non-empty file: #{path}"
    else
      log "removing empty file: #{path}"
      File.unlink path unless $dry_run
    end

  when 'directory'
    # When `--recursive` is passed, go through the children paths and delete
    # them if empty as well. Do this before checking for `$kind`, as this
    # lets us do `rm-empty --files --recursive path/to/dir`
    if $recursive
      Dir.children(path).sort.each do |child|
        delete_path File.join(path, child), is_first: false
      end
    end

    if $kind == :files
      log "not removing non-file path: #{path}"
      return
    end

    # If we're deleting `.DS_Store`, delete it if it's the only file that exists.
    # Note that this does have a race condition, as after checking here, someone
    # could make another file. But that doesn't really matter much, as if there's
    # no extra files, there's no point in a `.DS_Store`
    if DELETE_DS_STORE && Dir.children(path) == ['.DS_Store']
      ds = File.join(path, '.DS_Store')

      if File.file?(ds)
        log "removing .DS_Store: #{ds}"
        File.unlink ds unless $dry_run
      else
        warn ".DS_Store is not a file: #{ds}"
      end
    end

    # Now check to see if the directory is empty; if it is we remove it
    if Dir.empty?(path)
      log "removing empty folder: #{path}"
      Dir.rmdir path unless $dry_run
    else
      log "not removing non-empty folder: #{path}"
    end
  else
    # Skip symlinks, as they're not really "empty". Also, this helps prevent cycles.
    warn "not removing #{ftype}: #{path}"
  end
end

$SUCCESS = true
$paths.each do |path|
  delete_path path, is_first: true
rescue SystemCallError => err
  warn "#{path}: #{err}"
  $SUCCESS = false
end

exit $SUCCESS
