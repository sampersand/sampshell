#!/bin/sh

# Remove an empty directory; deletes any `.DS_Store` files first for ease-of-use
# on macos

# Safety first!
set -euC

readonly scriptname="${0##*/}"

usage () { cat; } <<USAGE
usage: $scriptname [-rDvne] directory [...]
options:
	-r	Remove all empty child directories first
	-D	Do not treat ".DS_Store" files specially
	-v	Print out directories as they're removed
	-n	Don't actually remove directories; implies -v
	-e	Exit immediately upon error

Removies empty directories. Unless -D is specified, .DS_Store files are removed
first before checking for emptiness
USAGE

################################################################################
#                                Parse Options                                 #
################################################################################

recursive=
exit_early=
verbose=
dry_mode=
rm_ds_store=1
while getopts 'hDrevn' option; do
	case $option in
	h) usage; exit ;;
	r) recursive=1 ;;
	D) rm_ds_store= ;;
	e) exit_early=1 ;;
	v) verbose=1 ;;
	n) dry_mode=1 verbose=1 ;;
	*) exit 2 ;;
	esac
done

shift $(( OPTIND - 1 ))

# Require at least one string as an argument
if [ $# -eq 0 ]; then
	usage >&2
	exit 1
fi

################################################################################
#                                Helper Methods                                #
################################################################################

# Define the `log_file_for_deletion` method only to print files as they're
# deleted if verbose mode is enabled
if [ -n "$verbose" ]; then
	log_file_for_deletion () { printf '%s\n' "$1"; }
else
	log_file_for_deletion () { :; }
fi

# Handle failure conditions during the script; if an early exit is requested,
# then we exit immediately. Normally, though, we just set the `exit_status`
# which is reported at the end of the script
exit_status=0
if [ -n "$exit_early" ]; then
	set_exit_status () { exit 1; }
else
	set_exit_status () { exit_status=1; }
fi

# Warn prints a message to stderr, then sets the exit status. It prepends the
# script name, and appends a newline, for ease-of-use.
warn () {
	fmt="%s: $1\n"
	shift
	printf "$fmt" "$scriptname" "$@" >&2
	set_exit_status
}

################################################################################
#                             Meat of the Program                              #
################################################################################

# Returns whether the directory is empty.
is_directory_empty () {
	! ls -A1q -- "$1" | grep -q .
}

# Removes an empty directory, deleting any `.DS_Store`s which may exist (and
# also recursively descending into child directories if `-r` was supplied)
# first. Any deleted files are logged if verbose mode is enabled.
remove_directory () {
	# If it's not a directory, then just set the error, and return
	if [ ! -d "$1" ]; then
		warn '%s: Not a directory' "$1"
		return
	fi

	# If there's a `.DS_Store` file, go ahead and remove it
	if [ -n "$rm_ds_store" ] && [ -e "$1"/.DS_Store ]; then
		log_file_for_deletion "$1/.DS_Store"
		if [ -z "$dry_mode" ] && ! rm -f -- "$1"/.DS_Store; then
			set_exit_status
			return
		fi
	fi

	# If we're recursing, then iterate through all children directories,
	# and remove them.
	if [ -n "$recursive" ]; then
		# (Use glob trick to so we don't iterate over `.` or `..`)
		for file in "$1"/* "$1"/.[!.]* "$1"/..?*; do
			# Only recurse if it's a directory, and not a symlink
			if [ -d "$file" ] && ! [ -L "$file" ]; then
				remove_directory "$file"
			fi
		done
	fi

	# Remove the directory if it's now empty.
	if is_directory_empty "$1"; then
		log_file_for_deletion "$1"
		if [ -z "$dry_mode" ] && ! rmdir -- "$1"; then
			set_exit_status
		fi
	fi
}


# Remove each directory argument supplied
for directory; do
	remove_directory "$directory"
done

# Exit with the exit status
exit $exit_status
