#!/usr/bin/env ruby

##
# Print the url for a repo, or a file in the repo
##

require 'optparse2'
require 'gvars'
require 'sw'

OptParse2.new nil, 20 do |op|
  op.program_name = $program_name.sub(/\Agit-/, 'git ')
  op.summary 'Print the link to a repository, a file in the repo, or a range within it.'

  op.on '-r', '--repo=REPO', 'Change to REPO; if not specified, uses REPO containing FILE. If no FILE, uses PWD.'

  op.group :branch do
    op.on '-b', '--branch=NAME', 'Explicitly use branch NAME'
    op.on '-c', '--current', 'Use the current branch'
    op.on '-m', '--master', 'Use the master branch'; $branch = :master
    op.on '-p', '--permalink', 'Use a permalink'
  end

  op.pos 'file', 'The file to use'
  op.pos 'start[-end]', 'The range of lines in the file', /\d+(?:-\d+)?/, key: :range

  op.parse! into: GVars, abort: true
end

if $repo
  Dir.chdir $repo rescue abort!("cannot cd to repo #$repo")
elsif $file
  dir = File.directory?($file) ? $file : File.dirname($file)
  Dir.chdir(dir) rescue abort!("cannot cd to dir: #{dir}")
end

REPO = x!('gh repo view --json=url --jq=.url')
BRANCH = case $branch
         when :current   then x!('git branch --show-current')
         when :master    then x!('git master-branch')
         when :permalink then x!('git rev-parse HEAD')
         else                 $branch
         end

if $file
  if File.directory?($file) && !$file.end_with?('/')
    $file += '/'
  end

  $file = $file.delete_prefix x!('git rev-parse --show-toplevel') + '/' # maybe also --show-prefix eventually?
  $file.concat "#L#{$range.sub('-', '-L')}" if $range
end

if !$file && $branch == :master
  puts REPO
else
  puts "#{REPO}/#{$file ? 'blob' : 'tree'}/#{BRANCH}#{$file && '/'}#{$file}"
end
