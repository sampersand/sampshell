#!/bin/csh -f

switch ( $#argv )
case 1:
	set x = "`realpath "$argv[1]:q"`"
	if ( $status ) exit
	set argv = ( "$x:t" "$x" )
case 2:
	breaksw
default:
	echo "usage: ${0:t} [cdpath-name] directory" >/dev/tty
	exit 1
endsw

if ( ! -d $argv[2]:q ) then
	echo "${0:t}: not a directory: $argv[2]" >/dev/tty
	exit 1
endif

set shorthand = $argv[1]
set directory = $argv[2]
set target = ~/.cdpath/$shorthand:q

mkdir -p ~/.cdpath

if ( -e $target ) then
	echo "named directory '$shorthand' already exists,"\
	     "and points to: `realpath $target:q`" >/dev/tty
	exit 1
endif

ln -s $directory:q $target:q
