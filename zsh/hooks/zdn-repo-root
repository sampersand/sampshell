#!zsh
emulate -L zsh
# Support `~[rr]`, which simply expands to the root of the repo. Also supports
# `~[rr:<path>]` which  is the root of that path.

case $1 in
n)
	local dir=
	case $2 in
		rr) ;;
		rr:*) dir=${${2#rr:}:h} ;;
		*) return 1 ;;
	esac

	# make reply a global array (if its not already)
	typeset -ga reply
	reply=( $(git ${dir:+-C} ${dir:+$dir} rev-parse --show-toplevel 2>/dev/null) ) ;;

# To support expansions (eg in prompts), then uncomment the following
# d)
# 	local top
# 	top=$(git -C $2 rev-parse --show-toplevel 2>/dev/null) || return 1
# 	reply=( "rr($top:t)" $#top ) ;;

c)
	# complete names; adapted from documentation. TODO: have these expand
	# if `:` is supplied afterwards.
	local expl
	_wanted dynamic-dirs expl 'dynamic directory' compadd -S\] rr ;;

*)
	# Nothing else is supported
	return 1
esac
